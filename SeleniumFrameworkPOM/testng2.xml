<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
    
    <test thread-count="5" name="Submit Order Test">
        <classes>
            <!-- 1. sumbittest is inside the pageobject package folder -->
            <class name="SeleniumFrameworkDesign.seleniumframework.pageobject.sumbittest"/>
            
            <!-- 2. StandaloneTest is inside the TestComponents package folder -->
            <class name="SeleniumFrameworkDesign.seleniumframework.TestComponents.BaseTest"/> 
        </classes>
    </test>
    
    <test name="Error Validation Test">
        <classes>
            <!-- 3. Errovalidation is inside the main seleniumframework folder -->
            <class name="SeleniumFrameworkDesign.seleniumframework.Errovalidation"/>
        </classes>
    </test>

</suite> <!-- Suite -->
